{
  "headers": [
    {
      "source": "/clients/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "redirects": [
    { "source": "/sync/:path*", "destination": "/404.html", "permanent": false },
    { "source": "/db/:path*", "destination": "/404.html", "permanent": false }
  ]
}
